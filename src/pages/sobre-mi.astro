---
import { c, md } from '../lib/content';
import Base from '../layouts/Base.astro';
import SocialLinks from '../components/SocialLinks.astro';
import { getGallery } from '../lib/portal-data';
const pageTitle = await c('sobre-mi', 'page_title');
const subtitle = await c('sobre-mi', 'subtitle');
const bio = await Promise.all([1, 2, 3, 4].map((n) => c('sobre-mi', `bio_p${n}`)));
const gallery = await getGallery();
const mosaic = [1, 2, 3].map((n) => gallery.get(`mosaico-${n}`)!);
const trail = Array.from({ length: 10 }, (_, i) => gallery.get(`trayectoria-${i + 1}`)!);
---
<Base title="Sobre mí | Fernanda Tárraga" description="Trayectoria de Fernanda Tárraga como analista funcional de sistemas y analista de datos." current="sobre">
    <h1 class="pt-page-title">{pageTitle}</h1>

    <section class="pt-about" aria-labelledby="profesion">
      <div class="pt-about-portrait">
        <img src="/assets/fernanda-retrato.webp" width="512" height="1024" alt="Fernanda Tárraga sonriendo junto a la ventana de su oficina" fetchpriority="high">
      </div>
      <div class="pt-about-bio">
        <h2 id="profesion">{subtitle}</h2>
        {bio.map((p) => <p set:html={md(p)} />)}
        <p class="pt-sample">[Texto de muestra, pendiente de confirmar por Fernanda] Espacio reservado para ampliar la biografía: intereses, forma de trabajo y objetivos profesionales.</p>
        <nav class="pt-social pt-social-inline" aria-label="Redes sociales"><SocialLinks /></nav>
        <div class="pt-about-links">
          <a class="pt-button pt-button-cv" href="/contacto/">Contáctame</a>
        </div>
      </div>
    </section>

    <div class="pt-mosaic" aria-label="Mosaico de fotos">
      {mosaic.map((m) => (
        <figure>
          {m.image_url ? <img src={m.image_url} alt={m.alt} style="object-position: 70% center" loading="lazy" /> : <div class="pt-ph">Foto pendiente</div>}
        </figure>
      ))}
    </div>

    <div class="pt-trail" aria-label="Trayectoria">
      {trail.map((t, i) => (
        <figure class={i >= 8 ? 'pt-trail-wide' : undefined}>
          <div class="pt-trail-img">{t.image_url ? <img src={t.image_url} alt={t.alt} loading="lazy" /> : <div class="pt-ph">Foto pendiente</div>}</div>
          <figcaption>{t.caption}</figcaption>
        </figure>
      ))}
    </div>
</Base>
