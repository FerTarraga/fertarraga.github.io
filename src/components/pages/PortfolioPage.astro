---
// Portafolio de Fernanda en español o inglés. Los proyectos de la lista salen de la base; los casos largos están en la página.
import Base from '../../layouts/Base.astro';
import { getProjects } from '../../lib/portal-data';
import { getCases } from '../../lib/cases';
import CaseModal from '../CaseModal.astro';

interface Props { lang?: 'es' | 'en' }
const { lang = 'es' } = Astro.props;
const en = lang === 'en';
const L = (es: string, enText: string) => (en ? enText : es);

const projects = await getProjects(lang);
const cases = await getCases(lang);
const caseSlugs = new Set(cases.map((c) => c.slug));
const groups = [...new Set(projects.map((p) => p.category))].map((category) => ({ category, items: projects.filter((p) => p.category === category) }));
const contactHref = en ? '/en/contact/' : '/contacto/';
---
<Base
  title={L('Portafolio | Fernanda Tárraga', 'Portfolio | Fernanda Tárraga')}
  description={L('Casos de Fernanda Tárraga: calidad de datos en Interaxios y la web app de turnos GM Nails.', 'Case studies by Fernanda Tárraga: data quality at Interaxios and the GM Nails appointment web app.')}
  current="portafolio"
  lang={lang}
>
  <h1 class="pt-page-title">{L('Portafolio', 'Portfolio')}</h1>
  <div class="pt-folio" id="proyectos">
    <p>{L('Casos de trabajo con datos y sistemas. Hacé clic en un proyecto para ver el problema, lo que se hizo y el resultado.', 'Work cases with data and systems. Click a project to see the problem, what was done and the result.')}</p>
    {groups.map((g) => (
      <section>
        <p class="pt-folio-group"><strong>{g.category}</strong></p>
        <ul>
          {g.items.map((p) => (
            <li>{caseSlugs.has(p.slug) ? <a class="pt-link-gold" href={`?caso=${p.slug}`} data-pt-case={p.slug} aria-haspopup="dialog">{p.title}</a> : <strong>{p.title}</strong>}{p.summary ? ` · ${p.summary}` : ''}</li>
          ))}
        </ul>
      </section>
    ))}
    <blockquote class="pt-quote"><p>{L('Para saber si un dato sirve, primero hay que entender qué decisión depende de él.', 'To know whether data is useful, you first need to understand which decision depends on it.')}</p></blockquote>
    <div class="pt-folio-shot"><div class="pt-ph">{L('Imagen de proyecto pendiente', 'Project image pending')}</div></div>

    <p class="pt-folio-end"><a class="pt-link-gold" href={contactHref}>{L('Contáctame', 'Contact me')}</a></p>
  </div>
  <CaseModal cases={cases} lang={lang} />
</Base>
