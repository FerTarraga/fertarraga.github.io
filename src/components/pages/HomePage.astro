---
// Inicio de Fernanda en español o inglés. Los textos salen de site_content (con valores por defecto en los dos idiomas).
import Base from '../../layouts/Base.astro';
import ContactForm from '../ContactForm.astro';
import { c, md } from '../../lib/content';
import { getHomePhoto } from '../../lib/eventos';

interface Props { lang?: 'es' | 'en' }
const { lang = 'es' } = Astro.props;
const en = lang === 'en';
const L = (es: string, enText: string) => (en ? enText : es);
const p = en ? { about: '/en/about/', portfolio: '/en/portfolio/' } : { about: '/sobre-mi/', portfolio: '/portafolio/' };

const t = (k: string) => c('home', k, lang);
const [bannerTitle, bannerButton, introTitle, introLink, quote, bandTitle, bandLead, bandMore, contactTitle] = await Promise.all(
  ['banner_title', 'banner_button', 'intro_title', 'intro_link', 'quote', 'band_title', 'band_lead', 'band_more', 'contact_title'].map(t),
);
const intro = await Promise.all([1, 2, 3, 4].map((n) => t(`intro_p${n}`)));
const cols = await Promise.all([1, 2, 3].map(async (n) => ({ title: await t(`col${n}_title`), text: n < 3 ? await t(`col${n}_text`) : '' })));
const checks = await Promise.all([1, 2, 3].map((n) => t(`check${n}`)));
const homePhoto = await getHomePhoto();
---
<Base
  title={L('Fernanda Tárraga | Analista Funcional de Sistemas | Data Analyst', 'Fernanda Tárraga | Functional Systems Analyst | Data Analyst')}
  description={L('Fernanda Tárraga, analista funcional de sistemas y analista de datos: calidad de datos, análisis funcional y desarrollo web.', 'Fernanda Tárraga, functional systems analyst and data analyst: data quality, functional analysis and web development.')}
  current="inicio"
  lang={lang}
  form
>
  <section class="pt-banner" aria-label={L('Presentación', 'Introduction')}>
    <div class="pt-banner-copy">
      <h1>{bannerTitle}</h1>
      <a class="pt-button" href={p.about}>{bannerButton}</a>
    </div>
    <div class="pt-banner-photo">
      <img src="/assets/fernanda-portada.webp" width="1440" height="960" alt={L('Fernanda Tárraga, analista funcional de sistemas, con blazer azul sentada junto a un cuaderno', 'Fernanda Tárraga, functional systems analyst, in a blue blazer sitting next to a notebook')} style="object-position: 70% center" fetchpriority="high" />
    </div>
  </section>

  <section class="pt-intro" id="sobre-mi" aria-labelledby="introduccion">
    <div class="pt-intro-inner">
      <div>
        <h2 id="introduccion">{introTitle}</h2>
        {intro.map((x) => <p set:html={md(x)} />)}
        <p><a class="pt-link-gold" href={p.about}>{introLink}</a></p>
      </div>
      <div class="pt-intro-photo">
        <img src="/assets/fernanda-ventana.webp" width="1040" height="693" alt={L('Fernanda Tárraga trabajando junto a la ventana, con su computadora y un cuaderno', 'Fernanda Tárraga working by the window, with her computer and a notebook')} style="object-position: 62% center" loading="lazy" />
      </div>
    </div>
  </section>

  <section class="pt-statement" aria-label={L('Mi enfoque', 'My approach')}>
    <blockquote class="pt-quote"><p>{quote}</p></blockquote>
    <div class="pt-statement-photo">{homePhoto ? <img src={homePhoto.url} alt={homePhoto.alt} loading="lazy" /> : <div class="pt-ph">{L('Foto de trabajo pendiente', 'Work photo pending')}</div>}</div>
  </section>

  <section class="pt-band" id="proyectos" aria-labelledby="trabajo">
    <h2 id="trabajo">{bandTitle}</h2>
    <p class="pt-band-lead">{bandLead}</p>
    <div class="pt-band-cols">
      <div><h3><a href={`${p.portfolio}#interaxios`}>{cols[0].title}</a></h3><p>{cols[0].text}</p></div>
      <div><h3><a href={`${p.portfolio}#gm-nails`}>{cols[1].title}</a></h3><p>{cols[1].text}</p></div>
      <div id="recursos"><h3><a href={`${p.portfolio}#chequeos`}>{cols[2].title}</a></h3>
        <ul>{checks.map((x) => <li>{x}</li>)}</ul>
      </div>
    </div>
    <p class="pt-band-more"><a href={p.portfolio}>{bandMore}</a></p>
  </section>

  <section class="pt-contact-home" id="hablemos" aria-labelledby="contacto-titulo">
    <div class="pt-narrow">
      <h2 id="contacto-titulo">{contactTitle}</h2>
      <ContactForm id="home" lang={lang} />
    </div>
  </section>
</Base>
