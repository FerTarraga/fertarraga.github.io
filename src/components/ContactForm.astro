---
// Formulario de contacto (envío por Formspree, con reCAPTCHA si hay clave). Misma estructura que el de Mauricio.
interface Props { id?: string; lang?: 'es' | 'en' }
const { id = 'contacto', lang = 'es' } = Astro.props;
const L = lang === 'en'
  ? { name: 'Name', email: 'Email', subject: 'Subject', message: 'Message', req: '(required)', send: 'Send', copy: 'Message ready to copy' }
  : { name: 'Nombre', email: 'Correo electrónico', subject: 'Asunto', message: 'Mensaje', req: '(obligatorio)', send: 'Enviar', copy: 'Mensaje listo para copiar' };
---
<div class="pt-form-wrap">
  <form class="pt-form" data-pt-form id={id} novalidate>
    <div class="pt-field">
      <label for={`${id}-name`}>{L.name}<span class="pt-req">{L.req}</span></label>
      <input id={`${id}-name`} name="name" type="text" autocomplete="name" required aria-describedby={`${id}-name-err`} />
      <div class="pt-error" id={`${id}-name-err`} role="alert"></div>
    </div>
    <div class="pt-field">
      <label for={`${id}-email`}>{L.email}<span class="pt-req">{L.req}</span></label>
      <input id={`${id}-email`} name="email" type="email" autocomplete="email" required aria-describedby={`${id}-email-err`} />
      <div class="pt-error" id={`${id}-email-err`} role="alert"></div>
    </div>
    <div class="pt-field">
      <label for={`${id}-subject`}>{L.subject}<span class="pt-req">{L.req}</span></label>
      <input id={`${id}-subject`} name="subject" type="text" autocomplete="off" required aria-describedby={`${id}-subject-err`} />
      <div class="pt-error" id={`${id}-subject-err`} role="alert"></div>
    </div>
    <div class="pt-field">
      <label for={`${id}-message`}>{L.message}<span class="pt-req">{L.req}</span></label>
      <textarea id={`${id}-message`} name="message" required aria-describedby={`${id}-message-err`}></textarea>
      <div class="pt-error" id={`${id}-message-err`} role="alert"></div>
    </div>
    <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" aria-hidden="true" style="position:absolute;left:-9999px" />
    <div class="pt-field pt-form-output" id={`${id}-output`} hidden>
      <label for={`${id}-copy`}>{L.copy}</label>
      <textarea id={`${id}-copy`} readonly></textarea>
    </div>
    <div class="pt-field pt-captcha-field" hidden>
      <div class="pt-captcha"></div>
      <div class="pt-error" data-captcha-err role="alert"></div>
    </div>
    <div class="pt-form-actions">
      <button class="pt-button" type="submit">{L.send}</button>
      <p class="pt-form-status" role="status"></p>
    </div>
  </form>
</div>
