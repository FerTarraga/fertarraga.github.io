---
import '../styles/personal-profile.css';
import '../styles/portal.css';
import SocialLinks from '../components/SocialLinks.astro';
import { SITE } from '../data/site';
import { getNavItems, getSettings } from '../lib/portal-data';
import { altPath, type Lang } from '../data/routes';

interface Props {
  title: string;
  description?: string;
  current?: string;
  form?: boolean;
  lang?: Lang;
  noindex?: boolean;
}
const { lang = 'es' } = Astro.props;
const menuItems = await getNavItems(lang);
const settings = await getSettings(lang);
const path = Astro.url.pathname;
const isHere = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
const { title, description = SITE.tagline, current, form = false, noindex = true } = Astro.props;
---
<!doctype html>
<html lang={lang}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  {noindex && <meta name="robots" content="noindex" />}
  <meta name="description" content={description} />
  <title>{title}</title>
  <link rel="icon" type="image/svg+xml" href="/assets/favicon-fernanda.svg" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;600;700&family=Raleway:wght@300;700&display=swap" rel="stylesheet" />
</head>
<body class="pt-body">
  <header class="pt-header">
    <p class="pt-title"><a href="/">{SITE.name}</a></p>
    <p class="pt-tagline">{settings.tagline}</p>
    <nav class="pt-nav" aria-label="Principal">
      <input class="pt-toggle" type="checkbox" id="pt-menu-toggle" aria-label={lang === 'en' ? 'Open or close the menu' : 'Abrir o cerrar el menú'} />
      <label class="pt-menu-button" for="pt-menu-toggle">{lang === 'en' ? 'Menu' : 'Menú'} <span class="pt-plus" aria-hidden="true">+</span><span class="pt-x" aria-hidden="true">×</span></label>
      <ul class="pt-menu">
        {menuItems.map((i) => <li><a href={i.href} aria-current={isHere(i.href) ? 'page' : undefined}>{i.label}</a></li>)}
      </ul>
    </nav>
    <nav class="pt-social" aria-label={lang === 'en' ? 'Social networks' : 'Redes sociales'}><SocialLinks lang={lang} /></nav>
    <nav class="pt-langnav" aria-label={lang === 'en' ? 'Language' : 'Idioma'}>
      {lang === 'es' ? <span aria-current="true">ES</span> : <a href={altPath(path, 'en')} hreflang="es" lang="es">ES</a>}
      <span aria-hidden="true">|</span>
      {lang === 'en' ? <span aria-current="true">EN</span> : <a href={altPath(path, 'es')} hreflang="en" lang="en">EN</a>}
    </nav>
  </header>
  <main class="pt">
    <slot />
  </main>
  <footer class="pt-footer">
    <p><a class="pt-footer-name" href="/">{SITE.name}</a>, &copy; {SITE.year}</p>
  </footer>
  {form && <script is:inline src="/assets/site-config.js"></script>}
  {form && <script is:inline src="/assets/contact-form.js"></script>}
</body>
</html>
